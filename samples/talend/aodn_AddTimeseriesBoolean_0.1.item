  <node componentName="tPostgresqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="352" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tPostgresqlRow_1"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tPostgresqlConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;localhost&quot;"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;5432&quot;"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;&quot;"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;&quot;"/>
    <elementParameter field="TEXT" name="TYPE" value="PostgreSQL"/>
    <elementParameter field="TEXT" name="USER" value="&quot;&quot;"/>
    <elementParameter field="TEXT" name="PASS" value=""/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value=""/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;update timeseries&#10;&#9;set sea_water_temperature_b = mgrp.temp_b, &#10;&#9;&#9;sea_water_salinity_b = mgrp.psal_b, &#10;&#9;&#9;sea_water_pressure_due_to_sea_water_b = mgrp.pres_rel_b,&#10;&#9;&#9;turbidity_b = mgrp.turb_b, &#10;&#9;&#9;mass_concentration_of_chlorophyll_in_sea_water_b = mgrp.cphl_b, &#10;&#9;&#9;mole_concentration_of_dissolved_molecular_oxygen_in_sea_water_b = mgrp.dox1_b&#10;&#9;from (&#10;&#9;&#9;select m.ts_id,&#10;&#9;&#9;&#9;count(m.\&quot;TEMP\&quot;) &gt; 0 as temp_b, &#10;&#9;&#9;&#9;count(m.\&quot;PSAL\&quot;) &gt; 0 as psal_b, &#10;&#9;&#9;&#9;count(m.\&quot;PRES_REL\&quot;) &gt; 0 as pres_rel_b,&#10;&#9;&#9;&#9;count(m.\&quot;TURB\&quot;) &gt; 0 as turb_b, &#10;&#9;&#9;&#9;count(m.\&quot;CPHL\&quot;) &gt; 0 as cphl_b, &#10;&#9;&#9;&#9;count(m.\&quot;DOX1\&quot;) &gt; 0 as dox1_b&#10;&#9;&#9;from measurement m join timeseries t&#10;&#9;&#9;&#9;on (m.ts_id = t.id)&#10;&#9;&#9;where t.file_id = &quot; + context.fileId + &quot;&#10;&#9;&#9;group by m.ts_id&#10;&#9;) as mgrp&#10;&#9;where timeseries.id = mgrp.ts_id;&quot;"/>
