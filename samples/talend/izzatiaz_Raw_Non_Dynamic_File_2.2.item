    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_4" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_JAVA" name="CODE_START" value="// populate query with loading_date as additional column using insert overwrite function&#xA;context.whole_query  = &quot;INSERT OVERWRITE TABLE &quot;;&#xA;context.whole_query += context.Target_Database+ &quot;.&quot; + context.Target_Table_Name;&#xA;if (context.File_Unique==null||context.File_Unique.toUpperCase().equals(&quot;N&quot;)){&#xA;context.whole_query += &quot; SELECT *, from_unixtime(unix_timestamp(), 'yyyy-MM-dd HH:mm:SS') loading_date &quot;;&#xA;context.whole_query += &quot;FROM &quot;+context.Source_Database+&quot;.&quot;+context.Dependency_Table;&#xA;} else if (context.File_Unique.toUpperCase().equals(&quot;Y&quot;)){&#xA;context.whole_query += &quot; SELECT &quot;+context.column_name.replace(&quot;,`file_date`,`file_name`&quot;,&quot;&quot;)+&quot;, MAX(file_date) as file_date, MAX(file_name) as file_name, from_unixtime(unix_timestamp(), 'yyyy-MM-dd HH:mm:SS') loading_date &quot;;&#xA;context.whole_query += &quot;FROM &quot;+context.Source_Database+&quot;.&quot;+context.Dependency_Table;&#xA;context.whole_query += &quot; GROUP BY &quot;+context.column_name.replace(&quot;,`file_date`,`file_name`&quot;,&quot;&quot;);&#xA;}&#xA;&#xA;      "/>
    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="// here is the main part of the component,&#xA;// a piece of code executed in the row&#xA;// loop&#xA;"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// end of the component, outside/closing the loop&#xA;      "/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V4.0" value="true" show="false"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="OverwriteQuery"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaFlex_4"/>
  </node>
  <node componentName="tJavaFlex" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="736" posY="640">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaFlex_3" show="false"/>
    <elementParameter field="CHECK" name="DATA_AUTO_PROPAGATE" value="true"/>
    <elementParameter field="MEMO_JAVA" name="CODE_START" value="// doing comparision using merge key for incremental load, existing rows will be rank 2 and new rows will be rank 1. At the end of query only will take rank 1 rows means will extract the latest data if the merge key are the same for the rows&#xA;context.whole_query = &quot;INSERT OVERWRITE TABLE &quot;;&#xA;context.whole_query+= context.Target_Database+&quot;.&quot;+context.Target_Table_Name;&#xA;context.whole_query += &quot; SELECT &quot;+context.column_name+&quot;, from_unixtime(unix_timestamp(), 'yyyy-MM-dd HH:mm:SS') loading_date &quot;;&#xA;context.whole_query += &quot;FROM ( SELECT &quot;+context.column_name+&quot;, row_number() OVER (PARTITION BY &quot;+context.Merge_Key+&quot; ORDER BY ranking) as ranking &quot;; &#xA;context.whole_query += &quot;FROM ( SELECT &quot;+context.column_name+&quot;, 1 ranking FROM &quot;+context.Source_Database+&quot;.&quot;+context.Dependency_Table+&quot; UNION SELECT &quot;+context.column_name+&quot;, 2 ranking FROM &quot;+context.Target_Database+&quot;.&quot;+context.Target_Table_Name+&quot;) t )tt &quot;;&#xA;context.whole_query += &quot;WHERE ranking = 1&quot;;&#xA;&#xA;System.out.println(context.whole_query);&#xA;"/>
    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="// here is the main part of the component,&#xA;// a piece of code executed in the row&#xA;// loop&#xA;"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// end of the component, outside/closing the loop&#xA;      "/>
