    <elementParameter field="MEMO_JAVA" name="CODE" value="if (context.column_name == null||context.column_name.length()&lt;1) &#xA;{&#xA;&#x9;context.column_name = &quot;`&quot;+input_row.field+&quot;`&quot;;&#xA;}&#xA;else&#xA;{&#x9;&#xA;&#x9;context.column_name = context.column_name +&quot;,&quot;+&quot;`&quot;+input_row.field+&quot;`&quot;;&#xA;}&#xA;//////////// Data Type //////&#xA;if (context.data_type == null||context.data_type.length()&lt;1) &#xA;{&#xA;&#x9;context.data_type = input_row.data_type;&#xA;}&#xA;else&#xA;{&#x9;&#xA;&#x9;context.data_type = context.data_type +&quot;;&quot;+input_row.data_type;&#xA;}&#xA;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="AppendColumnName"/>
