  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="480" posY="480">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_4" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="context.create_table_query = &quot;CREATE EXTERNAL TABLE IF NOT EXISTS &quot;+context.Target_Database+&quot;.&quot;+context.Target_Table_Name+&quot; ( &quot;;&#xA;&#xA;//declare variable&#xA;String input_data_type = context.data_type;&#xA;String[] parts_data_type = input_data_type.split(&quot;;&quot;);&#xA;String input_column = context.column_name;&#xA;String[] parts_column = input_column.split(&quot;,&quot;);&#xA;&#xA;//It loops through an array of column names (parts_column) and their corresponding data types (parts_data_type).For each column, it appends the column name and its data type to the create_table_query string.If the column is not the last one in the list, it adds a comma , after the column definition to separate it from the next column.&#xA;for(int i=0;i &lt; parts_column.length;i++){&#xA;&#x9;context.create_table_query += parts_column[i]+&quot;  &quot;+parts_data_type[i];&#xA;&#x9;if(i &lt; parts_column.length - 1){&#xA;&#x9;&#x9;context.create_table_query += &quot; , &quot;;&#xA;&#x9;}&#xA;}&#xA;context.create_table_query += &quot;, loading_date timestamp) STORED AS PARQUET LOCATION'&quot;+ context.HDFS_Path + context.Target_Database+&quot;.db/&quot;+context.Target_Table_Name+&quot;' TBLPROPERTIES ('parquet.compress'='SNAPPY','external.table.purge'='true')&quot;;&#xA;&#xA;&#xA;//System.out.println(&quot;\n\nFor RAW Process:&quot;+context.Source_Schema+&quot;_&quot;+context.Target_Table_Name);&#xA;//System.out.println(context.create_table_query+&quot;\n\n&quot;);&#xA;&#xA;//STG_&lt;Target_DB>.&lt;Target_Schema>_&lt;Source_Table>_STG&#xA;//PROD_&lt;Target_DB>.&lt;Target_Schema>_&lt;Source_Table>&#xA;//CUR_&lt;Target_DB>.CUR_&lt;Target_Schema>_&lt;Source_Table>&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="PrepHiveQuery"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" label="userdns" name="tJava_4">
      <column comment="" key="false" length="-1" name="field" nullable="true" pattern="&quot;dd-MM-yyyy&quot;" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
