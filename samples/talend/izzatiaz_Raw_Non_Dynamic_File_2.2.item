  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="-352" posY="1024">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_2" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MARIADB" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;172.21.131.208&quot;" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;3306&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;ingestion&quot;" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MYSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;de&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;Mapper_Control_Table&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;WITH T0&#xD;&#xA;AS (&#xD;&#xA;&#x9;SELECT MCT.ID&#xD;&#xA;&#x9;&#x9;,MCT.Interface_Type&#xD;&#xA;&#x9;&#x9;,MCT.Source_Database_Type&#xD;&#xA;&#x9;&#x9;,MCT.Source&#xD;&#xA;&#x9;&#x9;,MCT.Source_Database&#xD;&#xA;&#x9;&#x9;,MCT.Source_Schema&#xD;&#xA;&#x9;&#x9;,MCT.Source_Table&#xD;&#xA;&#x9;&#x9;,MCT.Dependency_Table&#xD;&#xA;&#x9;&#x9;,MCT.File_Name&#xD;&#xA;&#x9;&#x9;,MCT.File_Path&#xD;&#xA;&#x9;&#x9;,MCT.Target_Database_Type&#xD;&#xA;&#x9;&#x9;,MCT.Target_Source&#xD;&#xA;&#x9;&#x9;,MCT.Target_Database&#xD;&#xA;&#x9;&#x9;,MCT.Target_Schema&#xD;&#xA;&#x9;&#x9;,MCT.Target_Table_Name&#xD;&#xA;&#x9;&#x9;,MCT.Delta&#xD;&#xA;&#x9;&#x9;,MCT.Incremental&#xD;&#xA;&#x9;&#x9;,MCT.Merge_Key&#xD;&#xA;&#x9;&#x9;,MCT.Last_Update_Date&#xD;&#xA;&#x9;&#x9;,MCT.Process_Name&#xD;&#xA;&#x9;&#x9;,MCT.`Sequence`&#xD;&#xA;&#x9;&#x9;,MCT.Rerun_Flag&#xD;&#xA;&#x9;&#x9;,MCT.Active&#xD;&#xA;&#x9;&#x9;,MCT.Frequency&#xD;&#xA;&#x9;&#x9;,MCT.Program_Path&#xD;&#xA;&#x9;&#x9;,MCT.STAFF_ID&#xD;&#xA;&#x9;&#x9;,MCT.ROW_ID&#xD;&#xA;&#x9;&#x9;,MCT.scd_start&#xD;&#xA;&#x9;&#x9;,MCT.scd_end&#xD;&#xA;&#x9;&#x9;,MCT.scd_active&#xD;&#xA;&#x9;&#x9;,MCT.HDFS_Path&#xD;&#xA;&#x9;&#x9;,C.Host AS Source_Host&#xD;&#xA;&#x9;&#x9;,C.Port AS Source_Port&#xD;&#xA;&#x9;&#x9;,C.`User`as Source_User&#xD;&#xA;&#x9;&#x9;,C.Password AS Source_Password&#xD;&#xA;&#x9;&#x9;,MCT.Day_Of_Retention_Trace&#xD;&#xA;&#x9;&#x9;,MCT.Where_Clause_Column&#xD;&#xA;&#x9;&#x9;,MCT.Curated_Hist_Flag&#xD;&#xA;&#x9;&#x9;,MCT.Category&#xD;&#xA;&#x9;&#x9;,MCT.Day_of_Retention_Curated_Hist&#xD;&#xA;&#x9;&#x9;,MCT.Day_of_Retention_Curated_DV&#xD;&#xA;&#x9;&#x9;,MCT.Curated_DV_Flag&#xD;&#xA;&#x9;&#x9;,MCT.Hash_ID_Excl_Col&#xD;&#xA;&#x9;&#x9;,MCT.`Unique`&#xD;&#xA;&#x9;&#x9;,MCT.Hash_Diff_Check&#xD;&#xA;&#x9;FROM &quot;+context.MARIADB_Mapper_Control_Table+&quot; MCT&#xD;&#xA;&#x9;LEFT JOIN &quot;+context.MARIADB_Credentials+&quot; C ON MCT.Target_Database = C.`Database`&#xD;&#xA;&#x9;&#x9;AND MCT.Target_Source = C.Source&#xD;&#xA;&#x9;WHERE C.SCD_ACTIVE = 1&#xD;&#xA;&#x9;&#x9;AND MCT.INTERFACE_TYPE = 'TABLE'&#xD;&#xA;&#x9;&#x9;AND MCT.SOURCE_DATABASE_TYPE = 'HIVE'&#xD;&#xA;&#x9;&#x9;AND MCT.RERUN_FLAG = 'Y'&#xD;&#xA;&#x9;&#x9;AND MCT.ACTIVE = 'Y'&#xD;&#xA;&#x9;&#x9;AND MCT.FREQUENCY = '&quot;+context.Frequency+&quot;'&#xD;&#xA;&#x9;&#x9;AND MCT.SCD_ACTIVE = 1&#xD;&#xA;&#x9;&#x9;AND MCT.SEQUENCE = 3 &#xD;&#xA;&#x9;)&#xD;&#xA;&#x9;,T1&#xD;&#xA;AS (&#xD;&#xA;&#x9;SELECT MCT.ID&#xD;&#xA;&#x9;&#x9;,MCT.Interface_Type&#xD;&#xA;&#x9;&#x9;,MCT.Source_Database_Type&#xD;&#xA;&#x9;&#x9;,MCT.Source&#xD;&#xA;&#x9;&#x9;,MCT.Source_Database&#xD;&#xA;&#x9;&#x9;,MCT.Source_Schema&#xD;&#xA;&#x9;&#x9;,MCT.Source_Table&#xD;&#xA;&#x9;&#x9;,MCT.Dependency_Table&#xD;&#xA;&#x9;&#x9;,MCT.File_Name&#xD;&#xA;&#x9;&#x9;,MCT.File_Path&#xD;&#xA;&#x9;&#x9;,MCT.Target_Database_Type&#xD;&#xA;&#x9;&#x9;,MCT.Target_Source&#xD;&#xA;&#x9;&#x9;,MCT.Target_Database&#xD;&#xA;&#x9;&#x9;,MCT.Target_Schema&#xD;&#xA;&#x9;&#x9;,MCT.Target_Table_Name&#xD;&#xA;&#x9;&#x9;,MCT.Delta&#xD;&#xA;&#x9;&#x9;,MCT.Incremental&#xD;&#xA;&#x9;&#x9;,MCT.Merge_Key&#xD;&#xA;&#x9;&#x9;,MCT.Last_Update_Date&#xD;&#xA;&#x9;&#x9;,MCT.Process_Name&#xD;&#xA;&#x9;&#x9;,MCT.`Sequence`&#xD;&#xA;&#x9;&#x9;,MCT.Rerun_Flag&#xD;&#xA;&#x9;&#x9;,MCT.Active&#xD;&#xA;&#x9;&#x9;,MCT.Frequency&#xD;&#xA;&#x9;&#x9;,MCT.Program_Path&#xD;&#xA;&#x9;&#x9;,MCT.STAFF_ID&#xD;&#xA;&#x9;&#x9;,MCT.ROW_ID&#xD;&#xA;&#x9;&#x9;,MCT.scd_start&#xD;&#xA;&#x9;&#x9;,MCT.scd_end&#xD;&#xA;&#x9;&#x9;,MCT.scd_active&#xD;&#xA;&#x9;FROM &quot;+context.MARIADB_Mapper_Control_Table+&quot; MCT&#xD;&#xA;&#x9;WHERE MCT.INTERFACE_TYPE = 'TABLE'&#xD;&#xA;&#x9;&#x9;AND MCT.SOURCE_DATABASE_TYPE = 'HIVE'&#xD;&#xA;&#x9;&#x9;AND MCT.RERUN_FLAG = 'N'&#xD;&#xA;&#x9;&#x9;AND MCT.ACTIVE = 'Y'&#xD;&#xA;&#x9;&#x9;AND MCT.FREQUENCY = '&quot;+context.Frequency+&quot;'&#xD;&#xA;&#x9;&#x9;AND MCT.SCD_ACTIVE = 1&#xD;&#xA;&#x9;&#x9;AND MCT.SEQUENCE = 2&#xD;&#xA;&#x9;)&#xD;&#xA;SELECT MCT.ID&#xD;&#xA;&#x9;,MCT.Interface_Type&#xD;&#xA;&#x9;,MCT.Source_Database_Type&#xD;&#xA;&#x9;,MCT.Source&#xD;&#xA;&#x9;,MCT.Source_Database&#xD;&#xA;&#x9;,MCT.Source_Schema&#xD;&#xA;&#x9;,MCT.Source_Table&#xD;&#xA;&#x9;,MCT.Dependency_Table&#xD;&#xA;&#x9;,MCT.File_Name&#xD;&#xA;&#x9;,MCT.File_Path&#xD;&#xA;&#x9;,MCT.Target_Database_Type&#xD;&#xA;&#x9;,MCT.Target_Source&#xD;&#xA;&#x9;,MCT.Target_Database&#xD;&#xA;&#x9;,MCT.Target_Schema&#xD;&#xA;&#x9;,MCT.Target_Table_Name&#xD;&#xA;&#x9;,MCT.Delta&#xD;&#xA;&#x9;,MCT.Incremental&#xD;&#xA;&#x9;,MCT.Merge_Key&#xD;&#xA;&#x9;,MCT.Last_Update_Date&#xD;&#xA;&#x9;,MCT.Process_Name&#xD;&#xA;&#x9;,MCT.`Sequence`&#xD;&#xA;&#x9;,MCT.Rerun_Flag&#xD;&#xA;&#x9;,MCT.Active&#xD;&#xA;&#x9;,MCT.Frequency&#xD;&#xA;&#x9;,MCT.Program_Path&#xD;&#xA;&#x9;,MCT.STAFF_ID&#xD;&#xA;&#x9;,MCT.ROW_ID&#xD;&#xA;&#x9;,MCT.scd_start&#xD;&#xA;&#x9;,MCT.scd_end&#xD;&#xA;&#x9;,MCT.scd_active&#xD;&#xA;&#x9;,MCT.Source_Host&#xD;&#xA;&#x9;,MCT.Source_Port&#xD;&#xA;&#x9;,MCT.Source_User&#xD;&#xA;&#x9;,MCT.Source_Password&#xD;&#xA;&#x9;,MCT.Day_Of_Retention_Trace&#xD;&#xA;&#x9;,C.Host AS Target_Host&#xD;&#xA;&#x9;,C.Port AS Target_Port&#xD;&#xA;&#x9;,C.`User`as Target_User&#xD;&#xA;&#x9;,C.Password AS Target_Password&#xD;&#xA;&#x9;,E.Email&#xD;&#xA;&#x9;,MCT.Where_Clause_Column&#xD;&#xA;&#x9;,MCT.HDFS_Path&#xD;&#xA;&#x9;,MCT.Curated_Hist_Flag&#xD;&#xA;&#x9;,MCT.Category&#xD;&#xA;&#x9;,MCT.Day_of_Retention_Curated_Hist&#xD;&#xA;&#x9;,MCT.Day_of_Retention_Curated_DV&#xD;&#xA;&#x9;,MCT.Curated_DV_Flag&#xD;&#xA;&#x9;,MCT.Hash_ID_Excl_Col&#xD;&#xA;&#x9;,MCT.`Unique`&#xD;&#xA;&#x9;,MCT.Hash_Diff_Check&#xD;&#xA;FROM T0 MCT&#xD;&#xA;LEFT JOIN &quot;+context.MARIADB_Credentials+&quot; C ON MCT.Target_Database = C.`Database`&#xD;&#xA;&#x9;AND MCT.Target_Source = C.Source&#xD;&#xA;LEFT JOIN &quot;+context.MARIADB_Email+&quot; E ON MCT.Source = E.Source&#xD;&#xA;INNER JOIN T1 ON T1.Source_Table = MCT.Source_Table&#xD;&#xA;&#x9;AND T1.Source = MCT.Source&#xD;&#xA;&#x9;AND MCT.Dependency_Table = T1.Target_Table_Name&#xD;&#xA;&#x9;AND T1.Target_Database = MCT.Source_Database&#xD;&#xA;WHERE C.SCD_ACTIVE = 1&#xD;&#xA;&#x9;AND E.SCD_ACTIVE = 1&#xD;&#xA;&#x9;AND MCT.Dependency_Table = '&quot; + context.Target_Table_Name +&quot;'&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="mysql_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeStringSync=true&amp;enabledTLSProtocols=TLSv1.2,TLSv1.1,TLSv1&amp;keepAlive=true&amp;keepAliveInterval=2000&quot;" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="ENABLE_STREAM" value="false" show="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="ID"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="Interface_Type"/>
      <elementValue elementRef="TRIM" value="false"/>
