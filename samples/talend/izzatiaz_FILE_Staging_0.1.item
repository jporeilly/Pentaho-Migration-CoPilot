    <elementParameter field="MEMO" name="SQL_QUERY" value="&quot;select &#13;&#10;md5(CONCAT(COALESCE(start_time, '^^'), COALESCE(end_time, '^^'), COALESCE(msisdn, '^^'), COALESCE(device_model, '^^'), COALESCE(cell, '^^'), COALESCE(rat, '^^'), COALESCE(apn, '^^'), COALESCE(priceplan, '^^'), COALESCE(protocol, '^^'), COALESCE(traffic_type, '^^'), COALESCE(application, '^^'), COALESCE(volume_down, '^^'), COALESCE(volume_up, '^^'), COALESCE(http_host, '^^'), COALESCE(imsi, '^^'), COALESCE(imeisv, '^^'), COALESCE(mcc, '^^'), COALESCE(mnc, '^^'), COALESCE(tethering, '^^'), COALESCE(lac, '^^'), COALESCE(sac, '^^'), COALESCE(ci, '^^'), COALESCE(ecgi_enb_id, '^^'), COALESCE(ecgi_cell_id, '^^'), COALESCE(tcp_rtt_client, '^^'), COALESCE(tcp_rtt_server, '^^'), COALESCE(file_name, '^^'))) as hash_id,&#13;&#10;from_unixtime(CAST(start_time/1000000 AS INT)) as start_time,&#13;&#10;from_unixtime(CAST(end_time/1000000 AS INT)) as end_time,&#13;&#10;msisdn,&#13;&#10;device_model,&#13;&#10;cell,&#13;&#10;rat,&#13;&#10;apn,&#13;&#10;priceplan,&#13;&#10;protocol,&#13;&#10;traffic_type,&#13;&#10;application,&#13;&#10;volume_down,&#13;&#10;volume_up,&#13;&#10;http_host,&#13;&#10;imsi,&#13;&#10;imeisv,&#13;&#10;mcc,&#13;&#10;mnc,&#13;&#10;tethering,&#13;&#10;lac,&#13;&#10;sac,&#13;&#10;ci,&#13;&#10;ecgi_enb_id,&#13;&#10;ecgi_cell_id,&#13;&#10;tcp_rtt_client,&#13;&#10;tcp_rtt_server,&#13;&#10;file_date,&#13;&#10;file_name&#13;&#10;from row1&quot;" xmi:id="_pma-1isPEfChb4dQTAL6ng"/>
    <elementParameter field="LABEL" name="NOTE" value="NOTE : tSQLRow tables are named from incoming rows names.&#10;&#9;&#9;&#9;&#9;For example, if there are 2 incoming rows respectively named rowX&#10;&#9;&#9;&#9;&#9;and rowY, queries can&#10;&#9;&#9;&#9;&#9;be run FROM tables rowX and rowY.&#10;&#9;&#9;&#9;" xmi:id="_pma-1ysPEfChb4dQTAL6ng"/>
