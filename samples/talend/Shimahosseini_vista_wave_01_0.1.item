    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT distinct f.patient_dim_id,&#xD;&#xA;&#x9;r.diagnosis_route_label,&#xD;&#xA;    s.stage_label,&#xD;&#xA;    bgn.age age_bgn,&#xD;&#xA;    end1.age age_end&#xD;&#xA;FROM survey_qa_register_fact f,&#xD;&#xA;     diagnosis_route_dim r,&#xD;&#xA;     stage_dim s,&#xD;&#xA;&#x9; age_dim bgn,&#xD;&#xA;     age_dim end1&#xD;&#xA;WHERE f.diagnosis_route_dim_id = r.diagnosis_route_dim_id and&#xD;&#xA;&#x9;f.stage_dim_id = s.stage_dim_id and &#xD;&#xA;    f.age_dim_bgn = bgn.age_dim_id and&#xD;&#xA;    f.age_dim_end = end1.age_dim_id and &#xD;&#xA;    f.cancer_site_dim_id = 48&quot;"/>
