    <elementParameter field="MEMO_SQL" name="QUERY" value='"SELECT mbr_no AS \"MBR_NO\", first_nm AS \"FIRST_NM\", last_nm AS \"LAST_NM\",&#10;       city AS \"CITY\", mbr_status AS \"MBR_STATUS\"&#10;FROM cscu_core.members"'/>
