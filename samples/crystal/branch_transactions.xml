<?xml version="1.0" encoding="utf-8"?><Report Name="Branch Transaction Summary - Prompt" FileName="Branch Transaction Summary - Prompt.rpt" HasSavedData="False"><Database><Tables><Table Name="Command" Alias="Command" ClassName="CommandTable"><ConnectionInfo QE_DatabaseName="cscu_core" QE_DatabaseType="PostgreSQL" UserName="" Password=""/><Command>SELECT
  branches.br_name         AS "BRANCH_NAME",
  transactions.txn_dt      AS "TXN_DATE",
  transactions.acct_id     AS "ACCOUNT_ID",
  members.first_nm         AS "FIRST_NAME",
  members.last_nm          AS "LAST_NAME",
  transactions.txn_type_cd AS "TXN_TYPE",
  transactions.txn_amt     AS "AMOUNT"
FROM cscu_core.transactions
JOIN cscu_core.accounts ON accounts.acct_id = transactions.acct_id
JOIN cscu_core.members  ON members.mbr_id  = accounts.mbr_id
JOIN cscu_core.branches ON branches.br_id  = accounts.br_id
ORDER BY branches.br_name, transactions.txn_dt</Command><Fields><Field Name="BRANCH_NAME" ValueType="StringField"/><Field Name="TXN_DATE" ValueType="DateField"/><Field Name="ACCOUNT_ID" ValueType="StringField"/><Field Name="FIRST_NAME" ValueType="StringField"/><Field Name="LAST_NAME" ValueType="StringField"/><Field Name="TXN_TYPE" ValueType="StringField"/><Field Name="AMOUNT" ValueType="CurrencyField"/></Fields></Table></Tables></Database><DataDefinition><RecordSelectionFormula>{BRANCHES.BR_NAME} = {?Branch} and {TRANSACTIONS.TXN_AMT} &lt;&gt; 0</RecordSelectionFormula><Groups><Group ConditionField="{Command.BRANCH_NAME}"/></Groups><FormulaFieldDefinitions><FormulaFieldDefinition Name="FullName" FormulaName="{@FullName}" ValueType="StringField">{Command.FIRST_NAME} + ' ' + {Command.LAST_NAME}</FormulaFieldDefinition><FormulaFieldDefinition Name="RiskFlag" FormulaName="{@RiskFlag}" ValueType="StringField">If {Command.AMOUNT} &gt; 10000 Then "REVIEW" Else "OK"</FormulaFieldDefinition><FormulaFieldDefinition Name="RunningBalance" FormulaName="{@RunningBalance}" ValueType="NumberField">WhilePrintingRecords;
Shared NumberVar balance;
balance := balance + {Command.AMOUNT};
balance</FormulaFieldDefinition><FormulaFieldDefinition Name="TxnRiskBand" FormulaName="{@TxnRiskBand}" ValueType="StringField">Select {Command.TXN_TYPE}
Case "WIRE": "High risk"
Case "ATM": "Low risk"
Default: "Standard"</FormulaFieldDefinition></FormulaFieldDefinitions><ParameterFieldDefinitions><ParameterFieldDefinition Name="Branch" ParameterFieldName="{?Branch}" ValueType="StringField" PromptText="Branch name" DefaultValue="Phoenix Camelback"/></ParameterFieldDefinitions><SummaryFields><SummaryFieldDefinition Name="Sum of Command.AMOUNT" Operation="Sum" SummarizedField="{Command.AMOUNT}" Group="{Command.BRANCH_NAME}"/><SummaryFieldDefinition Name="Grand Total AMOUNT" Operation="Sum" SummarizedField="{Command.AMOUNT}"/></SummaryFields></DataDefinition><PrintOptions PaperOrientation="Landscape" PaperSize="PaperA4"><PageMargins topMargin="360" leftMargin="360" bottomMargin="360" rightMargin="360"/></PrintOptions><ReportDefinition><Areas><Area Kind="ReportHeader" Name="RHArea"><Sections><Section Name="RH" Height="1160"><SectionFormat EnableSuppress="false"><BackgroundColor Name="c" A="255" R="19" G="51" B="70" /></SectionFormat><ReportObjects><PictureObject Name="Logo" Left="160" Top="120" Width="2400" Height="880"><ImageData></ImageData></PictureObject><TextObject Name="Title" Text="Branch Transaction Summary" Left="3000" Top="160" Width="11200" Height="520" VerticalAlignment="middle"><Font FontName="Arial" Size="18" Bold="true"/><Color Name="c" A="255" R="255" G="255" B="255" /></TextObject><TextObject Name="Sub" Text="Demo: working prompt - change the Branch parameter" Left="3040" Top="680" Width="11200" Height="320" VerticalAlignment="middle"><Font FontName="Arial" Size="10" Bold="false"/><Color Name="c" A="255" R="201" G="162" B="74" /></TextObject><TextObject Name="Org" Text="Copperstate Credit Union" Left="11120" Top="200" Width="4880" Height="320" HorizontalAlignment="RightAlign" VerticalAlignment="middle"><Font FontName="Arial" Size="9" Bold="false"/><Color Name="c" A="255" R="255" G="255" B="255" /></TextObject><BoxObject Name="GoldRule" Left="0" Top="1100" Width="16120" Height="40"><BackgroundColor Name="c" A="255" R="201" G="162" B="74" /><Border TopL