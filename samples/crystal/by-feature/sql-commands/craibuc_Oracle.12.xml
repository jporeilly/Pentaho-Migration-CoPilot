    <CustomFunction Name="Colorize" Syntax="crFormulaSyntaxCrystal">
      <Text>// --------------------------------------------------------------------------------
// Author:      Craig Buchanan
// Created:     07/27/2011
// Purpose:     Color every other row as light tan
// Parameters:  row - supply Crystal Reports' RecordNumber or GroupNumber fuctions
//                to this parameter
//              color - a RGB() or Crystal Reports color constant (e.g. crRed)
//                defaults to light tan
// Returns:     numeric representation of RGB() or color constant
// --------------------------------------------------------------------------------
Function (Numbervar row, Optional Numbervar Color := RGB(239,235,220))

If Remainder(row,2)=0 Then
    Color
Else
    crNoColor</Text>
    </CustomFunction>
    <CustomFunction Name="SmartDate" Syntax="crFormulaSyntaxCrystal">
      <Text>// --------------------------------------------------------------------------------
// Author:      Craig Buchanan; craig.buchanan@cogniza.com
// Created:     7/19/2011
// Purpose:     convert 'smart' values to equivalent date values
// Parameters:  smartValue - mm/dd/yyyy; yyyy/mm/dd; [T|W|M|MB|ME|Q|Y|YB|YE][+|-][0...?]
//              dataDate - supply Crystal Reports DataDate function to this parameter
// Returns:     date
// --------------------------------------------------------------------------------
// Modified:    2/5/2013
// Author:      Craig Buchanan
// Purpose:     Ensure that Repository has most-recent version of function.
// --------------------------------------------------------------------------------
Function (Stringvar smartValue, Datevar dataDate)

    // mm/dd/yyyy; yyyy/mm/dd
    If smartValue="" Then
        dataDate

    Else If IsDate (smartValue) Then

        DateValue(smartValue)

    // 'smartdates'
    Else (

        Local Stringvar oper;
        Local Numbervar factor;

        // +/-
        if InStr(smartValue,"+")&gt;0 then (
            oper:="+";
            factor:=1
        )
        else if InStr(smartValue,"-")&gt;0 then (
            oper:="-";
            factor:=-1
        );
//        else
            //error
    
        // split M+1 into array of interval (M) and quantity (1)
        Local Stringvar array kv := Split(smartValue, oper);
        Local stringvar int:=ucase(kv[1]);
        Local Numbervar qty:=toNumber(kv[2]);
        //first day of current month
        Local Datevar MM_01_YY:=Date(Year(dataDate),Month(dataDate),1);

        select int
        //today
        case "T": CDate(DateAdd("d", qty*factor, dataDate))

        //week
        case "W": CDate(DateAdd("ww", qty*factor, dataDate))

        //month
        case "M": CDate(DateAdd("m", qty*factor, dataDate))
        case "MB": CDate( DateAdd("m", qty*factor, MM_01_YY ) )
        //
        case "ME": CDate( DateAdd("m", 1, DateAdd("m", qty*factor, MM_01_YY))-1 )

        //quarter
        case "Q": CDate(DateAdd("q", qty*factor, dataDate))

        //year
        case "Y": CDate(DateAdd("yyyy", qty*factor, dataDate))
        case "YB": CDate( DateAdd("yyyy", qty*factor, Date(Year(dataDate),1,1) ) )
        case "YE": CDate( DateAdd("yyyy", qty*factor, Date(Year(dataDate),12,31) ) )

        //unspecified
        default: dataDate
        ;

    )
</Text>
    </CustomFunction>
  </CustomFunctions>
