        <Command>SELECT T10.Name as 'GrupoVehic', T4.ItmsGrpNam as 'Grupo', 
avg(T8.U_OrdenGrupo) as 'OrdenGrupo',
T8.Code as 'CodGrupoLista', T8.Name as 'NombreGrupoLista', T8.U_EncGrupo,
avg(T9.U_OrdenSubGrupo) as 'OrdenSubGrupo',
T9.Code as 'CodSubGrupoLista', T9.Name as 'NombreSubgrupoLista', T9.U_EncSubGrupo,
avg(T0.[U_NS_OrdenEnLista]) as [OrdenEnLista],
T0.[ItemCode], T0.[SWW] as 'PLU', T11.Name as 'Marca',
T0.[ItemName], T0.[U_NS_DescAdic], T0.[FrgnName],
T2.[Currency], avg(T2.[Price]) as 'Precio', 
sum(T1.[OnHand]) as 'Stock', sum(T1.[OnOrder]) as 'OrdenCompra',

CASE
WHEN sum(T1.[OnHand]) &gt;0 THEN 'X'
ELSE '_' END AS 'Hand',

CASE
WHEN sum(T1.[OnOrder]) &gt;0 THEN 'X'
ELSE '_' END AS 'Ord',

T2.[Ovrwritten], T3.[FirmName] as 'Fabrica', 
T0.QryGroup14, T0.QryGroup18, T0.QryGroup11, T0.QryGroup19, 'Z-' + right(left(convert(nvarchar(7),T0.LastPurDat,20),4),2) AS 'UltCompra'
FROM OITM T0 
INNER JOIN OITW T1 ON T0.ItemCode = T1.ItemCode
INNER JOIN ITM1 T2 ON T0.ItemCode = T2.ItemCode
INNER JOIN OMRC T3 ON T0.FirmCode = T3.FirmCode
INNER JOIN OITB T4 ON T0.ItmsGrpCod = T4.ItmsGrpCod
INNER JOIN OWHS T5 ON T1.WhsCode = T5.WhsCode
INNER JOIN OPLN T6 ON T2.PriceList = T6.ListNum
INNER JOIN OARG T7 ON T0.CstGrpCode = T7.CstGrpCode
LEFT JOIN [@NS_GRUPOLISTA] T8 ON T0.U_NS_GrupoLista = T8.Code
LEFT JOIN [@NS_SUBGRUPOLISTA] T9 ON T0.U_NS_SubgrupoLista = T9.Code
LEFT JOIN [@NS_GRUPO_VEHICULO] T10 ON T0.U_NS_GrupoVehic = T10.Code
LEFT JOIN [@NS_MARCA_PARTE] T11 ON T0.U_NS_MarcaParte = T11.Code
WHERE T6.[ListName] like 'A01%' --T0.U_NS_SaleEnLista ='Y' and
and (T5.[WhsName] like '102%'  or T5.[WhsName] LIKE '202%') -- or T5.[WhsName] LIKE '151%' or T5.[WhsName] LIKE '251%'
-- and (T4.ItmsGrpNam like '1%' or T4.ItmsGrpNam like '201%' or T4.ItmsGrpNam like '202%')
group by T10.Name, T4.ItmsGrpNam, T8.U_OrdenGrupo, T9.U_Ordensubgrupo, T8.Code, T8.Name, T8.U_EncGrupo, 
T9.Code, T9.Name, T9.U_EncSubGrupo,
T0.[U_NS_OrdenEnLista], T0.[ItemCode], T0.[SWW], T11.Name, 
T0.[ItemName], T0.[U_NS_DescAdic], T0.[FrgnName],
T2.[Currency], 
T2.[Ovrwritten], T3.[FirmName], 
T0.QryGroup1, T0.QryGroup14, T0.QryGroup18, T0.QryGroup11, T0.QryGroup19, T0.LastPurDat
HAVING sum(T1.[OnHand]) &gt;0
ORDER BY T10.Name, t8.U_EncGrupo,  T9.U_ENCSubGrupo, T0.ItemName</Command>
