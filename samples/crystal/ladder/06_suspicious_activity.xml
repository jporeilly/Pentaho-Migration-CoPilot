<?xml version="1.0" encoding="utf-8"?><Report Name="Suspicious Activity Report" FileName="Suspicious Activity Report.rpt" HasSavedData="False"><Database><Tables><Table Name="Command" Alias="Command" ClassName="CommandTable"><ConnectionInfo QE_DatabaseName="cscu_core" QE_DatabaseType="PostgreSQL" UserName="" Password=""/><Command>SELECT s.filed_dt AS "FILED_DT", m.first_nm AS "FIRST_NM", m.last_nm AS "LAST_NM",
       s.activity_type_cd AS "ACTIVITY_TYPE_CD", s.sar_amt AS "SAR_AMT",
       s.sar_status AS "SAR_STATUS", s.narrative_txt AS "NARRATIVE_TXT"
