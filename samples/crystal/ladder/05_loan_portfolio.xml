<?xml version="1.0" encoding="utf-8"?><Report Name="Loan Portfolio" FileName="Loan Portfolio.rpt" HasSavedData="False"><Database><Tables><Table Name="Command" Alias="Command" ClassName="CommandTable"><ConnectionInfo QE_DatabaseName="cscu_core" QE_DatabaseType="PostgreSQL" UserName="" Password=""/><Command>SELECT b.br_name AS "BR_NAME", l.ln_no AS "LN_NO", l.ln_type_cd AS "LN_TYPE_CD",
       l.orig_amt AS "ORIG_AMT", l.prin_bal_amt AS "PRIN_BAL_AMT",
       l.apr_rt AS "APR_RT", l.ln_status AS "LN_STATUS"
FROM cscu_core.loans l
JOIN cscu_core.members  m ON m.mbr_id = l.mbr_id
JOIN cscu_core.branches b ON b.br_id  = m.br_id
ORDER BY b.br_name, l.ln_no</Command><Fields><Field Name="BR_NAME" ValueType="StringField"/><Field Name="LN_NO" ValueType="StringField"/><Field Name="LN_TYPE_CD" ValueType="StringField"/><Field Name="ORIG_AMT" ValueType="CurrencyField"/><Field Name="PRIN_BAL_AMT" ValueType="CurrencyField"/><Field Name="APR_RT" ValueType="NumberField"/><Field Name="LN_STATUS" ValueType="StringField"/></Fields></Table></Tables></Database><DataDefinition><Groups><Group ConditionField="{Command.BR_NAME}"/></Groups><FormulaFieldDefinitions></FormulaFieldDefinitions><ParameterFieldDefinitions></ParameterFieldDefinitions><SummaryFields><SummaryFieldDefinition Name="Sum of PRIN_BAL_AMT" Operation="Sum" SummarizedField="{Command.PRIN_BAL_AMT}" Group="{Command.BR_NAME}"/><SummaryFieldDefinition Name="Average of APR_RT" Operation="Average" SummarizedField="{Command.APR_RT}" Group="{Command.BR_NAME}"/><SummaryFieldDefinition Name="StdDev of APR_RT" Operation="StdDeviation" SummarizedField="{Command.APR_RT}" Group="{Command.BR_NAME}"/></SummaryFields></DataDefinition><PrintOptions PaperOrientation="Landscape" PaperSize="PaperA4"><PageMargins topMargin="360" leftMargin="360" bottomMargin="360" rightMargin="360"/></PrintOptions><ReportDefinition><Areas><Area Kind="ReportHeader" Name="RHArea"><Sections><Section Name="RH" Height="800"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name="Title" Text="Loan Portfolio by Branch" Left="0" Top="120" Width="14000" Height="480"><Font FontName="Arial" Size="16" Bold="true"/></TextObject><LineObject Name="Rule" Left="0" Top="680" Width="15200" Height="20"/></ReportObjects></Section></Sections></Area><Area Kind="PageHeader" Name="PHArea"><Sections><Section Name="PH" Height="400"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name="h_Loan #" Text="Loan #" Left="0" Top="40" Width="2600" Height="320"><Font FontName="Arial" Size="9" Bold="true"/></TextObject><TextObject Name="h_Type" Text="Type" Left="2600" Top="40" Width="200