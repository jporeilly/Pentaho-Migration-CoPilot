<?xml version="1.0" encoding="utf-8"?><Report Name="Member Statement" FileName="Member Statement.rpt" HasSavedData="False"><Database><Tables><Table Name="Command" Alias="Command" ClassName="CommandTable"><ConnectionInfo QE_DatabaseName="cscu_core" QE_DatabaseType="PostgreSQL" UserName="" Password=""/><Command>SELECT m.mbr_no AS "MBR_NO", m.first_nm AS "FIRST_NM", m.last_nm AS "LAST_NM",
       a.acct_no AS "ACCT_NO", t.txn_dt AS "TXN_DT", t.txn_type_cd AS "TXN_TYPE_CD",
       t.merch_nm AS "MERCH_NM", t.txn_amt AS "TXN_AMT"
FROM cscu_core.transactions t
JOIN cscu_core.accounts a ON a.acct_id = t.acct_id
JOIN cscu_core.members  m ON m.mbr_id  = a.mbr_id
ORDER BY m.mbr_no, a.acct_no, t.txn_dt</Command><Fields><Field Name="MBR_NO" ValueType="StringField"/><Field Name="FIRST_NM" ValueType="StringField"/><Field Name="LAST_NM" ValueType="StringField"/><Field Name="ACCT_NO" ValueType="StringField"/><Field Name="TXN_DT" ValueType="DateField"/><Field Name="TXN_TYPE_CD" ValueType="StringField"/><Field Name="MERCH_NM" ValueType="StringField"/><Field Name="TXN_AMT" ValueType="CurrencyField"/></Fields></Table></Tables></Database><DataDefinition><RecordSelectionFormula>{Command.MBR_NO} = {?MemberNo}</RecordSelectionFormula><Groups><Group ConditionField="{Command.MBR_NO}"/><Group ConditionField="{Command.ACCT_NO}"/></Groups><FormulaFieldDefinitions><FormulaFieldDefinition Name="FullName" FormulaName="{@FullName}" ValueType="StringField">{Command.FIRST_NM} + ' ' + {Command.LAST_NM}</FormulaFieldDefinition><FormulaFieldDefinition Name="RunningBalance" FormulaName="{@RunningBalance}" ValueType="NumberField">WhilePrintingRecords;
Shared NumberVar bal;
bal := bal + {Command.TXN_AMT};
bal</FormulaFieldDefinition></FormulaFieldDefinitions><ParameterFieldDefinitions><ParameterFieldDefinition Name="MemberNo" ParameterFieldName="{?MemberNo}" ValueType="StringField" PromptText="Member number" DefaultValue=""/></ParameterFieldDefinitions><SummaryFields><SummaryFieldDefinition Name="Sum of TXN_AMT" Operation="Sum" SummarizedField="{Command.TXN_AMT}" Group="{Command.ACCT_NO}"/></SummaryFields></DataDefinition><PrintOptions PaperOrientation="Landscape" PaperSize="PaperA4"><PageMargins topMargin="360" leftMargin="360" bottomMargin="360" rightMargin="360"/></PrintOptions><ReportDefinition><Areas><Area Kind="ReportHeader" Name="RHArea"><Sections><Section Name="RH" Height="800"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name="Title" Text="Member Account Statement" Left="0" Top="120" Width="14000" Height="480"><Font FontName="Arial" Size="16" Bold="true"/></TextObject><LineObject Name="Rule" Left="0" Top="680" Width="15200" Height="20"/></ReportObjects></Section></Sections></Area><Area Kind="PageHeader" Name="PHArea"><Sections><Section Name="PH" Height="400"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name="h_Date" Text="Date" Left="0" Top="40" Width="2400" Height="320"><Font FontName="Arial" Size="9" Bold="true"/></TextObject><TextObject Name="h_Type" Text="Type" Left="2400" Top="40" Width="2000" Height="320"><Font FontName="Arial" Size="9" Bold="true"/></TextObject><TextObject Name="h_Merchant" Text="Merchant" Left="4400" Top="40" Width="4000" Height="320"><Font FontName="Arial" Size="9" Bold="true"/></TextObject><TextObject Name="h_Amount" Text="Amount" Left="8400" Top="40" Width="2400" Height="320" HorizontalAlignment="RightAlign"><Font FontName="Arial" Size="9" Bold="true"/></TextObject><TextObject Name="h_Balance" Text="Balance" Left="10800" Top="40" Width="2400" Height="320" HorizontalAlignment="RightAlign"><Font FontName="Arial" Size="9" Bold="true"/></TextObject></ReportObjects></Section></Sections></Area><