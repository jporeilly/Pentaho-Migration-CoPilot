<?xml version="1.0" encoding="utf-8"?><Report Name="Transaction Register" FileName="Transaction Register.rpt" HasSavedData="False"><Database><Tables><Table Name="Command" Alias="Command" ClassName="CommandTable"><ConnectionInfo QE_DatabaseName="cscu_core" QE_DatabaseType="PostgreSQL" UserName="" Password=""/><Command>SELECT b.br_name AS "BR_NAME", t.txn_dt AS "TXN_DT", a.acct_no AS "ACCT_NO",
       m.first_nm AS "FIRST_NM", m.last_nm AS "LAST_NM",
       t.txn_type_cd AS "TXN_TYPE_CD", t.merch_nm AS "MERCH_NM", t.txn_amt AS "TXN_AMT"
FROM cscu_core.transactions t
JOIN cscu_core.accounts a ON a.acct_id = t.acct_id
JOIN cscu_core.members  m ON m.mbr_id  = a.mbr_id
JOIN cscu_core.branches b ON b.br_id   = a.br_id
ORDER BY b.br_name, t.txn_dt</Command><Fields><Field Name="BR_NAME" ValueType="StringField"/><Field Name="TXN_DT" ValueType="DateField"/><Field Name="ACCT_NO" ValueType="StringField"/><Field Name="FIRST_NM" ValueType="StringField"/><Field Name="LAST_NM" ValueType="StringField"/><Field Name="TXN_TYPE_CD" ValueType="StringField"/><Field Name="MERCH_NM" ValueType="StringField"/><Field Name="TXN_AMT" ValueType="CurrencyField"/></Fields></Table></Tables></Database><DataDefinition><Groups><Group ConditionField="{Command.BR_NAME}"/></Groups><FormulaFieldDefinitions><FormulaFieldDefinition Name="FullName" FormulaName="{@FullName}" ValueType="StringField">{Command.FIRST_NM} + ' ' + {Command.LAST_NM}</FormulaFieldDefinition><FormulaFieldDefinition Name="FlowType" FormulaName="{@FlowType}" ValueType="StringField">If {Command.TXN_AMT} &lt; 0 Then "DR" Else "CR"</FormulaFieldDefinition></FormulaFieldDefinitions><ParameterFieldDefinitions></ParameterFieldDefinitions><SummaryFields><SummaryFieldDefinition Name="Sum of TXN_AMT" Operation="Sum" SummarizedField="{Command.TXN_AMT}" Group="{Command.BR_NAME}"/><SummaryFieldDefinition Name="Grand Total TXN_AMT" Operation="Sum" SummarizedField="{Command.TXN_AMT}"/></SummaryFields></DataDefinition><PrintOptions PaperOrientation="Landscape" PaperSize="PaperA4"><PageMargins topMargin="360" leftMargin="360" bottomMargin="360" rightMargin="360"/></PrintOptions><ReportDefinition><Areas><Area Kind="ReportHeader" Name="RHArea"><Sections><Section Name="RH" Height="800"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name="Title" Text="Transaction Register by Branch" Left="0" Top="120" Width="14000" Height="480"><Font FontName="Arial" Size="16" Bold="true"/></TextObject><LineObject Name="Rule" Left="0" Top="680" Width="15200" Height="20"/></ReportObjects></Section></Sections></Area><Area Kind="PageHeader" Name="PHArea"><Sections><Section Name="PH" Height="400"><SectionFormat EnableSuppress="false"/><ReportObjects><TextObject Name=