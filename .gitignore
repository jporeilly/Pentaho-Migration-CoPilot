# built viewer binary (build with tools/RptViewer/build.ps1)
tools/RptViewer/*.exe
tools/RptViewer/*.pdb

# converted bundles belong in output/, never beside the authored dumps
samples/cr_demo/*.prpt

# by-feature is a generated index; the .rpt copies duplicate samples/crystal/corpus
samples/crystal/by-feature/**/*.rpt
