.venv/
node_modules/
frontend/dist/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
output/
config/
*.log
.env
tools/RptToXml/

# third-party rpt-rs evaluation (binaries + source clone, not vendored)
tools/rpt-rs/
